    "쿨타임을 지킬 때마다\n얼마나 절약했는지 알려드려요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Mal, wenn du eine Abklingzeit einhältst,\nzeigen wir dir, wie viel du gespart hast"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you keep a cooldown,\nwe show how much you saved"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you keep a cooldown,\nwe show how much you saved"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que cumples una espera,\nte mostramos cuánto has ahorrado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois que vous respectez une recharge,\nnous vous montrons combien vous avez économisé"
          }
        },
        "it" : {
          "stringUnit" : {
