    "참은 만큼 더 잘 보이게. 연 구독이나 평생 중에 고르세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참은 만큼 더 잘 보이게. 연 구독이나 평생 중에 고르세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See every urge you held back. Pick yearly or lifetime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See every urge you held back. Pick yearly or lifetime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍住的每一次都看得更清楚。可选年度订阅或终身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忍住的每一次都看得更清楚。可選年度訂閱或終身。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我慢した分だけ、よく見えるように。年額か買い切りを選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видите каждый порыв, перед которым устояли. Выберите год или навсегда."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira cada impulso que resististe. Elige anual o de por vida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh jeden Impuls, dem du widerstanden hast. Wähle jährlich oder lebenslang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez chaque envie à laquelle vous avez résisté. Choisissez l’année ou à vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi ogni impulso a cui hai resistito. Scegli annuale o a vita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja cada impulso que você segurou. Escolha anual ou vitalício."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เห็นทุกครั้งที่อดใจได้ชัดขึ้น เลือกรายปีหรือตลอดชีพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thấy rõ từng lần bạn đã kìm lòng. Chọn gói năm hoặc trọn đời."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvidíte každé pokušení, kterému jste odolali. Vyberte roční nebo doživotní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hver trang, du har modstået. Vælg årligt eller livstid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες κάθε παρόρμηση που κράτησες. Διάλεξε ετήσια ή εφ’ όρου ζωής."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe jokainen himo, jota vastustit. Valitse vuosi tai elinikäinen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat setiap dorongan yang berhasil kamu tahan. Pilih tahunan atau seumur hidup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hver trang du har stått imot. Velg årlig eller livstid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie elke impuls die je hebt weerstaan. Kies jaarlijks of levenslang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz każdą pokusę, której się oparłeś. Wybierz roczny lub dożywotni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se varje impuls du har stått emot. Välj årsvis eller livstid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direndiğin her isteği gör. Yıllık ya da ömür boyu seç."
          }
        }
      }
    },
