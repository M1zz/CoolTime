    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstane čitelné, i když zapneš Zvýšit kontrast nebo je pro tebe těžké rozeznat barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt kan stadig læses, også med Øget kontrast slået til, eller hvis farver er svære at skelne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt lesbar, auch mit „Kontrast erhöhen“ oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα παραμένουν ευανάγνωστα, ακόμη και με αυξημένη αντίθεση ή αν δυσκολεύεσαι να ξεχωρίσεις χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo sigue siendo legible, incluso con Aumentar contraste o si te cuesta distinguir los colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy luettavana, vaikka Lisää kontrastia olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec Augmenter le contraste ou si les couleurs sont difficiles à distinguer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya tetap terbaca, bahkan dengan Tingkatkan Kontras aktif atau saat warna sulit dibedakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile, anche con Aumenta contrasto o se è difficile distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを高めたり、色の区別がつきにくくても、内容を読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er fortsatt lesbart, selv med Øk kontrast på eller hvis det er vanskelig å se forskjell på farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft leesbaar, ook met Verhoog contrast aan of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko pozostaje czytelne, nawet po włączeniu Zwiększ kontrast lub gdy trudno odróżniać kolory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua legível, mesmo com Aumentar Contraste ligado ou se for difícil distinguir as cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся читаемым даже при включённом повышении контрастности или если трудно различать цвета."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt är fortfarande läsbart, även med Öka kontrast på eller om färger är svåra att skilja åt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างยังอ่านออกได้ แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı Artır açıkken veya renkleri ayırt etmek zorsa bile her şey okunabilir kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ vẫn dễ đọc, kể cả khi bật Tăng độ tương phản hoặc khi khó phân biệt màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使提高对比度，或不易分辨颜色，也能看清内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使提高對比，或不易分辨顏色，也能看清內容。"
          }
        }
      }
    },
