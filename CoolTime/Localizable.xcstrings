    "게임의 스킬 쿨타임처럼\n소비와 행동에 대기 시간을 설정해요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako u schopností ve hrách\nnastav čekací dobu pro výdaje a návyky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som en evnes nedkøling i et spil\nsætter du en ventetid på udgifter og vaner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie bei der Abklingzeit einer Fähigkeit im Spiel\nlegst du eine Wartezeit für Ausgaben und Gewohnheiten fest"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όπως ο χρόνος επαναφόρτισης μιας ικανότητας σε ένα παιχνίδι,\nόρισε χρόνο αναμονής για τα έξοδα και τις συνήθειές σου"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like skill cooldowns in a game,\nset a waiting time on spending and habits"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like skill cooldowns in a game,\nset a waiting time on spending and habits"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como la recarga de una habilidad en un juego,\nponle un tiempo de espera a tus gastos y hábitos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuten pelin taidon latausaika,\nasetat odotusajan menoille ja tottumuksille"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme la recharge d’une compétence dans un jeu,\ndéfinissez un temps d’attente pour vos dépenses et habitudes"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti waktu jeda skill di dalam game,\natur waktu tunggu untuk pengeluaran dan kebiasaanmu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come la ricarica di un’abilità in un gioco,\nimposta un tempo di attesa per spese e abitudini"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームのスキルのクールタイムのように\n消費や行動に待ち時間を設定します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임의 스킬 쿨타임처럼\n소비와 행동에 대기 시간을 설정해요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som nedkjølingen til en evne i et spill\nsetter du en ventetid på utgifter og vaner"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoals de cooldown van een skill in een game\nstel je een wachttijd in voor uitgaven en gewoontes"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak czas odnowienia umiejętności w grze,\nustaw czas oczekiwania dla wydatków i nawyków"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a recarga de uma habilidade em um jogo,\ndefina um tempo de espera para gastos e hábitos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как перезарядка умений в играх,\nзадайте время ожидания для трат и привычек"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som en förmågas nedkylning i ett spel\nsätter du en väntetid på utgifter och vanor"
          }
