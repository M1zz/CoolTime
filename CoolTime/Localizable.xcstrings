    "쿨타임이 반 지나면 \"반 왔어요\" 하고 응원해 드려요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿨타임이 반 지나면 \"반 왔어요\" 하고 응원해 드려요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a cooldown is half over, we’ll cheer you on: “Halfway there!”"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a cooldown is half over, we’ll cheer you on: “Halfway there!”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷却过半时，会提醒你“已经过半啦！”为你加油。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷卻過半時，會提醒你「已經過半囉！」為你加油。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クールタイムが半分過ぎたら「折り返しです！」と応援します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда пройдёт половина перезарядки, мы подбодрим: «Половина позади!»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando pase la mitad de la espera, te animaremos: «¡Ya vas por la mitad!»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist die Hälfte der Abklingzeit um, feuern wir dich an: „Halbzeit!“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mi-parcours, on vous encourage : « Déjà la moitié ! »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A metà ricarica ti incoraggiamo: «Sei a metà strada!»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na metade da recarga, a gente te anima: “Já está na metade!”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคูลดาวน์ผ่านไปครึ่งทาง เราจะส่งกำลังใจว่า “มาได้ครึ่งทางแล้ว!”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi thời gian chờ qua một nửa, chúng tôi sẽ cổ vũ: “Đã được nửa chặng rồi!”"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V polovině čekací doby vás povzbudíme: „Už jste v půlce!“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når ventetiden er halvvejs, hepper vi: “Du er halvvejs!”"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν περάσει η μισή αναμονή, θα σε ενθαρρύνουμε: «Έφτασες στη μέση!»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun odotusajasta on puolet takana, kannustamme: ”Puolivälissä jo!”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat waktu jeda sudah setengah jalan, kami akan menyemangati: “Sudah setengah jalan!”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når halve ventetiden har gått, heier vi: «Halvveis!»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de helft van de wachttijd om is, moedigen we je aan: ‘Al halverwege!’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
