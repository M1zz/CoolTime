    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: large text layouts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazovky se při zvětšení textu úhledně přeskupí a nic se neořízne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmene omarrangeres pænt, i stedet for at blive skåret af, når du gør teksten større."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirme ordnen sich bei größerer Schrift sauber neu an, statt abgeschnitten zu werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οθόνες αναδιατάσσονται καλαίσθητα αντί να κόβονται όταν μεγαλώνεις το κείμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas se reorganizan en lugar de recortarse al aumentar el tamaño del texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkymät järjestyvät siististi uudelleen sen sijaan, että ne leikkautuisivat, kun suurennat tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans se réorganisent proprement au lieu d’être coupés quand vous agrandissez le texte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar tertata ulang dengan rapi, bukan terpotong, saat kamu memperbesar teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schermate si riorganizzano in modo ordinato invece di venire tagliate quando ingrandisci il testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを大きくしても、表示が切れずに見やすくレイアウトされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermer ordnes pent på nytt i stedet for å bli avkuttet når du gjør teksten større."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermen ordenen zich netjes opnieuw in plaats van afgekapt te worden als je de tekst vergroot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrany układają się porządnie na nowo zamiast się ucinać, gdy powiększysz tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As telas se reorganizam direitinho em vez de serem cortadas quando você aumenta o texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экраны аккуратно перестраиваются, а не обрезаются, когда вы увеличиваете текст."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmar ordnas snyggt om i stället för att klippas av när du förstorar texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจอจัดเรียงใหม่อย่างเป็นระเบียบแทนที่จะถูกตัดเมื่อขยายขนาดตัวอักษร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni büyüttüğünde ekranlar kesilmek yerine düzgünce yeniden yerleşir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
