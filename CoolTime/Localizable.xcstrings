    "무료로는 쿨타임을 %lld개까지 걸 수 있어요. 더 걸려면 앱에서 Plus를 열어 주세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료로는 쿨타임을 %lld개까지 걸 수 있어요. 더 걸려면 앱에서 Plus를 열어 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the free plan you can set up to %lld cooldowns. To add more, unlock Plus in the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the free plan you can set up to %lld cooldowns. To add more, unlock Plus in the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费版最多可设置 %lld 个冷却。想设置更多，请在应用中开通 Plus。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費版最多可設定 %lld 個冷卻。想設定更多，請在 App 中開通 Plus。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料では%lld個までクールタイムを設定できます。さらに追加するには、アプリでPlusを利用してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно можно задать до %lld перезарядок. Чтобы добавить больше, откройте Plus в приложении."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el plan gratis puedes tener hasta %lld esperas. Para añadir más, activa Plus en la app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos sind bis zu %lld Abklingzeiten möglich. Für mehr schalte Plus in der App frei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gratuit, vous pouvez créer jusqu’à %lld temps de recharge. Pour en ajouter, activez Plus dans l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il piano gratuito puoi impostare fino a %lld ricariche. Per aggiungerne altre, attiva Plus nell’app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No plano grátis você pode ter até %lld recargas. Para adicionar mais, ative o Plus no app."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบบฟรีตั้งคูลดาวน์ได้สูงสุด %lld รายการ หากต้องการเพิ่ม โปรดเปิด Plus ในแอป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói miễn phí cho phép tối đa %lld mục chờ. Để thêm, hãy mở Plus trong ứng dụng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma můžete nastavit až %lld čekacích dob. Pro další si v aplikaci odemkněte Plus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kan du have op til %lld ventetider. Lås Plus op i appen for at tilføje flere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν μπορείς να ορίσεις έως %lld αναμονές. Για περισσότερες, ξεκλείδωσε το Plus στην εφαρμογή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmaiseksi voit asettaa enintään %lld odotusaikaa. Lisää varten avaa Plus apissa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi gratis bisa memasang hingga %lld waktu jeda. Untuk menambah, buka Plus di app."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kan du ha opptil %lld ventetider. Lås opp Plus i appen for å legge til flere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kun je tot %lld wachttijden instellen. Ontgrendel Plus in de app om er meer toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W wersji darmowej możesz ustawić do %lld czasów oczekiwania. Aby dodać więcej, odblokuj Plus w aplikacji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis kan du ha upp till %lld väntetider. Lås upp Plus i appen för att lägga till fler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz planda en fazla %lld bekleme süresi ekleyebilirsin. Daha fazlası için uygulamada Plus’ı aç."
          }
        }
      }
    }
  },
  "version" : "1.0"
