        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planerne kunne ikke indlæses. Tjek din internetforbindelse, og prøv igen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση των πακέτων. Έλεγξε τη σύνδεση στο διαδίκτυο και δοκίμασε ξανά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketteja ei voitu ladata. Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket tidak dapat dimuat. Periksa koneksi internet lalu coba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste inn planene. Sjekk internettforbindelsen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de abonnementen niet laden. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać planów. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa in planerna. Kontrollera internetanslutningen och försök igen."
          }
        },
        "tr" : {
