    "Face ID나 Touch ID로 앱을 잠가 내 쿨타임 기록을 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your history private."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your history private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para mantener privado tu historial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID または Touch ID でアプリをロックして、クールタイムの記録を守れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID나 Touch ID로 앱을 잠가 내 쿨타임 기록을 지켜요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或触控 ID 锁定应用，保护你的冷却记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 鎖定 App，保護你的冷卻記錄。"
          }
        }
      }
    },
    "Siri에게 말하거나 단축어로 바로 사용 기록을 남겨요." : {
      "comment" : "Roadmap item detail: Siri and Shortcuts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log a use instantly by asking Siri or running a shortcut."
          }
