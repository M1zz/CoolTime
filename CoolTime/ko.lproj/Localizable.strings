/* Korean — identity mappings for keys that differ from their display form */

/* Time format */
"%d일 %d시간" = "%1$d일 %2$d시간";
"%d시간 %d분" = "%1$d시간 %2$d분";
"%d분 %d초" = "%1$d분 %2$d초";
"%d초" = "%d초";

/* Cooldown preview */
"%d시간마다" = "%d시간마다";
"%d일마다" = "%d일마다";
"%d주마다" = "%d주마다";
"%d개월마다" = "%d개월마다";

/* Template cooldown format */
"%d개월" = "%d개월";
"%d주" = "%d주";
"%d일" = "%d일";

/* Toast */
"'%@' 쿨타임을 깼습니다" = "'%@' 쿨타임을 깼습니다";
"'%@' 추가됨" = "'%@' 추가됨";

/* Dynamic accessibility */
"%@ %@, 사용 가능" = "%1$@ %2$@, 사용 가능";
"%@ %@, 쿨타임 %@ 남음" = "%1$@ %2$@, 쿨타임 %3$@ 남음";
"남은 시간: %@" = "남은 시간: %@";
"예상: ₩%@" = "예상: ₩%@";
