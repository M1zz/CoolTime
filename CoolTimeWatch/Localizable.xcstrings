    "아직 쿨타임 중이에요. 그래도 남길까요?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě to neuběhlo. Přesto zapsat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke ovre endnu. Registrér alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht vorbei. Trotzdem eintragen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν τελείωσε ακόμα. Καταγραφή παρ’ όλα αυτά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still cooling down. Log it anyway?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still cooling down. Log it anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no ha terminado. ¿Registrarlo igualmente?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aika ei ole vielä kulunut. Kirjataanko silti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas encore fini. Noter quand même ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum selesai. Tetap catat?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è ancora finita. Registrare comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだクールタイム中です。それでも記録しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 쿨타임 중이에요. 그래도 남길까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke over ennå. Registrere likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niet voorbij. Toch vastleggen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nie minęło. Zapisać mimo to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não acabou. Registrar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время ещё не вышло. Всё равно отметить?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte över än. Logga ändå?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ครบเวลา จะบันทึกเลยไหม"
